generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payoutBankHolderName   String? @map("payout_bank_holder_name")
  payoutBankName         String? @map("payout_bank_name")
  payoutBankAccountNumber String? @map("payout_bank_account_number")
  payoutBankIfsc         String? @map("payout_bank_ifsc")
  payoutUpiId            String? @map("payout_upi_id")
  payoutUpiQrMimeType    String? @map("payout_upi_qr_mime_type")
  payoutUpiQrData        String? @map("payout_upi_qr_data") @db.Text

  branches                 Branch[]
  userRoles                UserTenantRole[]
  memberTrainerAssignments MemberTrainerAssignment[]
  sessionBookings          SessionBooking[]
  trainerFeedback          TrainerFeedback[]
  memberIssues             MemberIssue[]
  workoutTemplates         WorkoutTemplate[]
  dietTemplates            DietTemplate[]
  fitnessPlanAssignments   FitnessPlanAssignment[]
  workoutSetLogs           WorkoutSetLog[]
  dietMealLogs             DietMealLog[]
  memberBodyWeightLogs     MemberBodyWeightLog[]
  memberCheckIns           MemberCheckIn[]
  gymPayments              GymPayment[]
  paymentRefunds           PaymentRefund[]
  paymentLedgerEntries     PaymentLedgerEntry[]
  trainerProfiles          TrainerProfile[]
  membershipPlans          GymMembershipPlan[]
  trialLeads               TrialLead[]
  crmLeads                 CrmLead[]
  gymEquipment             GymEquipment[]
  gymNotifications         GymNotification[]
  trainerPayrollRuns       TrainerPayrollRun[]
  automationRules          GymAutomationRule[]
  reportExports            GymReportExport[]
  trainerMessages          TrainerMessage[]
  memberWeeklyWorkouts     MemberWeeklyWorkout[]
  trainerScheduleBlocks    TrainerScheduleBlock[]
  trainerBlockOutcomes     TrainerBlockOutcome[]
  auditLogs                AuditLog[]
  otherExpenses            GymOtherExpense[]
  supplementSales          GymSupplementSale[]
  exercises                Exercise[]
  workoutPlans             WorkoutPlan[]
  workoutPlanAssignments   WorkoutPlanAssignment[]
  workoutSessions          WorkoutSession[]
  workoutPersonalRecords   WorkoutPersonalRecord[]
  trainerLeaveRequests     TrainerLeaveRequest[]
  memberMemberships        MemberMembership[]
  nutritionScanLogs        NutritionScanLog[]
  foodIntakeEntries        FoodIntakeEntry[]
  foodCatalogItems         FoodCatalog[]
  memberStreakChallenges   MemberStreakChallenge[]
  registrationInvites    RegistrationInvite[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid())
  gymId     String   @map("gym_id")
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  accessGrants    UserBranchAccess[]
  checkIns        MemberCheckIn[]
  workoutPlans    WorkoutPlan[]
  workoutSessions WorkoutSession[]

  @@index([gymId])
  @@map("branches")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  phone                String?
  passwordHash         String   @map("password_hash")
  name                 String
  memberNotes          String?  @map("member_notes")
  profilePhotoMimeType String?  @map("profile_photo_mime_type")
  profilePhotoData     String?  @map("profile_photo_data") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenantRoles                       UserTenantRole[]
  refreshTokens                     RefreshToken[]
  passwordResetTokens               PasswordResetToken[]
  memberTrainerAssignmentsAsMember  MemberTrainerAssignment[] @relation("AssignmentMember")
  memberTrainerAssignmentsAsTrainer MemberTrainerAssignment[] @relation("AssignmentTrainer")
  bookingsAsMember                  SessionBooking[]          @relation("BookingMember")
  bookingsAsTrainer                 SessionBooking[]          @relation("BookingTrainer")
  trainerFeedbackAsMember           TrainerFeedback[]         @relation("FeedbackMember")
  trainerFeedbackAsTrainer          TrainerFeedback[]         @relation("FeedbackTrainer")
  memberIssues                      MemberIssue[]
  workoutTemplatesCreated           WorkoutTemplate[]
  dietTemplatesCreated              DietTemplate[]
  fitnessPlansAsMember              FitnessPlanAssignment[]   @relation("FitnessMember")
  fitnessPlansAsTrainer             FitnessPlanAssignment[]   @relation("FitnessTrainer")
  workoutSetLogs                    WorkoutSetLog[]
  dietMealLogs                      DietMealLog[]
  bodyWeightLogs                    MemberBodyWeightLog[]
  checkIns                          MemberCheckIn[]
  payments                          GymPayment[]
  paymentRefundsCreated             PaymentRefund[]
  trainerProfiles                   TrainerProfile[]
  gymNotifications                  GymNotification[]
  trainerMessagesSent               TrainerMessage[]          @relation("MessageSenderMember")
  trainerMessagesReceived           TrainerMessage[]          @relation("MessageTrainer")
  memberWeeklyWorkouts              MemberWeeklyWorkout[]
  trainerScheduleBlocks             TrainerScheduleBlock[]
  trainerBlockOutcomes              TrainerBlockOutcome[]
  auditLogs                         AuditLog[]
  pushDeviceTokens                  PushDeviceToken[]
  branchAccessGrants                UserBranchAccess[]
  crmLeadsAssigned                  CrmLead[]                 @relation("CrmLeadAssignee")
  otherExpensesRecorded             GymOtherExpense[]         @relation("OtherExpenseRecorder")
  supplementSalesRecorded           GymSupplementSale[]       @relation("SupplementSaleRecorder")
  supplementPurchasesAsMember       GymSupplementSale[]       @relation("SupplementSaleMember")
  exercisesCreated                  Exercise[]                @relation("ExerciseCreator")
  workoutPlansCreated               WorkoutPlan[]             @relation("WorkoutPlanCreator")
  workoutPlanAssignmentsAsMember    WorkoutPlanAssignment[]   @relation("WorkoutPlanMember")
  workoutPlanAssignmentsAsTrainer   WorkoutPlanAssignment[]   @relation("WorkoutPlanTrainer")
  workoutSessionsAsMember           WorkoutSession[]          @relation("WorkoutSessionMember")
  workoutPersonalRecords            WorkoutPersonalRecord[]
  trainerLeaveRequests              TrainerLeaveRequest[]     @relation("LeaveTrainer")
  trainerLeaveRequestsReviewed      TrainerLeaveRequest[]     @relation("LeaveReviewer")
  memberMemberships                 MemberMembership[]
  nutritionScanLogs                 NutritionScanLog[]
  foodIntakeEntries                 FoodIntakeEntry[]
  streakChallengesSent              MemberStreakChallenge[] @relation("StreakChallengeChallenger")
  streakChallengesReceived          MemberStreakChallenge[] @relation("StreakChallengeChallenged")
  streakChallengesWon               MemberStreakChallenge[] @relation("StreakChallengeWinner")
  streakChallengesCancelled         MemberStreakChallenge[] @relation("StreakChallengeCancelledBy")

  @@map("users")
}

model MemberStreakChallenge {
  id                  String    @id @default(uuid())
  gymId               String    @map("gym_id")
  challengerUserId    String    @map("challenger_user_id")
  challengedUserId    String    @map("challenged_user_id")
  exerciseId          String?   @map("exercise_id")
  exerciseName        String    @map("exercise_name")
  setCount            Int       @map("set_count")
  targetWeightKg      Float     @map("target_weight_kg")
  status              String    @default("pending")
  activeDay           String?   @map("active_day")
  winnerUserId        String?   @map("winner_user_id")
  winReason           String?   @map("win_reason")
  challengerStartedAt DateTime? @map("challenger_started_at")
  challengedStartedAt DateTime? @map("challenged_started_at")
  completedAt         DateTime? @map("completed_at")
  cancelledByUserId   String?   @map("cancelled_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  respondedAt         DateTime? @map("responded_at")

  tenant         Tenant                               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  challenger     User                                 @relation("StreakChallengeChallenger", fields: [challengerUserId], references: [id], onDelete: Cascade)
  challenged     User                                 @relation("StreakChallengeChallenged", fields: [challengedUserId], references: [id], onDelete: Cascade)
  winner         User?                                @relation("StreakChallengeWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  cancelledBy    User?                                @relation("StreakChallengeCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  setCompletions MemberStreakChallengeSetCompletion[]

  @@index([gymId, challengedUserId, status])
  @@index([gymId, challengerUserId, status])
  @@index([gymId, status, activeDay])
  @@map("member_streak_challenges")
}

model MemberStreakChallengeSetCompletion {
  id          String   @id @default(uuid())
  challengeId String   @map("challenge_id")
  userId      String   @map("user_id")
  setNumber   Int      @map("set_number")
  completedAt DateTime @default(now()) @map("completed_at")

  challenge MemberStreakChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, setNumber])
  @@index([challengeId])
  @@map("member_streak_challenge_set_completions")
}

model TrainerScheduleBlock {
  id            String @id @default(uuid())
  gymId         String @map("gym_id")
  trainerUserId String @map("trainer_user_id")
  timeLabel     String @map("time_label")
  title         String
  blockType     String @map("block_type")
  durationMin   Int?   @map("duration_min")
  sortOrder     Int    @default(0) @map("sort_order")

  tenant   Tenant                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer  User                  @relation(fields: [trainerUserId], references: [id], onDelete: Cascade)
  outcomes TrainerBlockOutcome[]

  @@index([gymId, trainerUserId])
  @@map("trainer_schedule_blocks")
}

model TrainerBlockOutcome {
  id            String   @id @default(uuid())
  gymId         String   @map("gym_id")
  trainerUserId String   @map("trainer_user_id")
  blockId       String   @map("block_id")
  logDate       String   @map("log_date")
  outcome       String
  note          String?
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant  Tenant               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer User                 @relation(fields: [trainerUserId], references: [id], onDelete: Cascade)
  block   TrainerScheduleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, logDate])
  @@index([trainerUserId, logDate])
  @@map("trainer_block_outcomes")
}

model TrainerProfile {
  id            String   @id @default(uuid())
  gymId         String   @map("gym_id")
  userId        String   @map("user_id")
  specialty     String   @default("General fitness")
  floorStatus   String   @default("on-floor") @map("floor_status")
  liveStatus    String   @default("available") @map("live_status")
  liveDetail    String?  @map("live_detail")
  liveUpdatedAt DateTime @default(now()) @map("live_updated_at")

  tenant Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@index([gymId])
  @@map("trainer_profiles")
}

model TrainerLeaveRequest {
  id               String    @id @default(uuid())
  gymId            String    @map("gym_id")
  trainerUserId    String    @map("trainer_user_id")
  fromDate         DateTime  @map("from_date") @db.Date
  toDate           DateTime  @map("to_date") @db.Date
  note             String?
  status           String    @default("pending")
  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant   Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer  User   @relation("LeaveTrainer", fields: [trainerUserId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("LeaveReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([gymId, status])
  @@index([trainerUserId, createdAt])
  @@map("trainer_leave_requests")
}

model GymMembershipPlan {
  id            String @id @default(uuid())
  gymId         String @map("gym_id")
  name          String
  durationLabel String @map("duration_label")
  priceInr      Int    @map("price_inr")
  durationDays  Int?   @map("duration_days")

  tenant      Tenant             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships MemberMembership[]

  @@index([gymId])
  @@map("gym_membership_plans")
}

model MemberMembership {
  id            String   @id @default(uuid())
  gymId         String   @map("gym_id")
  memberUserId  String   @map("member_user_id")
  planId        String   @map("plan_id")
  status        String
  startsAt      DateTime @map("starts_at") @db.Date
  endsAt        DateTime @map("ends_at") @db.Date
  renewedFromId String?  @map("renewed_from_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      User               @relation(fields: [memberUserId], references: [id], onDelete: Cascade)
  plan        GymMembershipPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  renewedFrom MemberMembership?  @relation("MembershipRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals    MemberMembership[] @relation("MembershipRenewal")

  @@index([gymId, memberUserId, createdAt])
  @@index([gymId, endsAt, status])
  @@map("member_memberships")
}

model TrialLead {
  id                  String @id @default(uuid())
  gymId               String @map("gym_id")
  name                String
  phone               String
  source              String
  trialEndsLabel      String @map("trial_ends_label")
  followUpLabel       String @map("follow_up_label")
  status              String
  assignedTrainerName String @map("assigned_trainer_name")

  tenant Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("trial_leads")
}

model CrmLead {
  id             String   @id @default(uuid())
  gymId          String   @map("gym_id")
  name           String
  phone          String?
  source         String
  stage          String
  nextAction     String   @map("next_action")
  referredBy     String?  @map("referred_by")
  assignedUserId String?  @map("assigned_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)
  assignedUser User?  @relation("CrmLeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([gymId, stage])
  @@map("crm_leads")
}

model GymEquipment {
  id               String @id @default(uuid())
  gymId            String @map("gym_id")
  name             String
  branch           String
  status           String
  nextServiceLabel String @map("next_service_label")

  tenant Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("gym_equipment")
}

model GymNotification {
  id        String   @id @default(uuid())
  gymId     String   @map("gym_id")
  userId    String   @map("user_id")
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  dedupeKey String?  @unique @map("dedupe_key")

  tenant Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId, userId, read])
  @@map("gym_notifications")
}

model TrainerPayrollRun {
  id            String @id @default(uuid())
  gymId         String @map("gym_id")
  trainerName   String @map("trainer_name")
  baseInr       Int    @map("base_inr")
  commissionInr Int    @map("commission_inr")
  period        String
  status        String

  tenant Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("trainer_payroll_runs")
}

model GymAutomationRule {
  id      String  @id @default(uuid())
  gymId   String  @map("gym_id")
  name    String
  channel String
  enabled Boolean @default(true)

  tenant Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("gym_automation_rules")
}

model GymReportExport {
  id           String @id @default(uuid())
  gymId        String @map("gym_id")
  name         String
  format       String
  lastRunLabel String @map("last_run_label")

  tenant Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("gym_report_exports")
}

model TrainerMessage {
  id            String   @id @default(uuid())
  gymId         String   @map("gym_id")
  memberUserId  String   @map("member_user_id")
  trainerUserId String   @map("trainer_user_id")
  senderRole    String   @map("sender_role")
  body          String
  createdAt     DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  User   @relation("MessageSenderMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  trainer User   @relation("MessageTrainer", fields: [trainerUserId], references: [id], onDelete: Cascade)

  @@index([gymId, memberUserId, trainerUserId])
  @@map("trainer_messages")
}

model MemberWeeklyWorkout {
  id           String   @id @default(uuid())
  gymId        String   @map("gym_id")
  memberUserId String   @map("member_user_id")
  source       String
  planJson     Json     @map("plan_json")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member User   @relation(fields: [memberUserId], references: [id], onDelete: Cascade)

  @@unique([gymId, memberUserId, source])
  @@map("member_weekly_workouts")
}

model GymPayment {
  id                String   @id @default(uuid())
  gymId             String   @map("gym_id")
  memberUserId      String   @map("member_user_id")
  title             String
  amountInr         Int      @map("amount_inr")
  method            String
  status            String
  refundedAmountInr Int      @default(0) @map("refunded_amount_inr")
  idempotencyKey    String?  @unique @map("idempotency_key")
  providerOrderId   String?  @unique @map("provider_order_id")
  proofMimeType     String?  @map("proof_mime_type")
  proofData         String?  @map("proof_data") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant        Tenant               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member        User                 @relation(fields: [memberUserId], references: [id], onDelete: Cascade)
  refunds       PaymentRefund[]
  ledgerEntries PaymentLedgerEntry[]

  @@index([gymId, status])
  @@index([memberUserId])
  @@map("gym_payments")
}

model PaymentRefund {
  id               String   @id @default(uuid())
  gymId            String   @map("gym_id")
  paymentId        String   @map("payment_id")
  amountInr        Int      @map("amount_inr")
  reason           String?
  status           String   @default("succeeded")
  idempotencyKey   String   @unique @map("idempotency_key")
  createdByUserId  String?  @map("created_by_user_id")
  providerRefundId String?  @unique @map("provider_refund_id")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant        Tenant               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payment       GymPayment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdBy     User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  ledgerEntries PaymentLedgerEntry[]

  @@index([gymId, createdAt])
  @@index([paymentId])
  @@map("payment_refunds")
}

model PaymentLedgerEntry {
  id        String   @id @default(uuid())
  gymId     String   @map("gym_id")
  paymentId String?  @map("payment_id")
  refundId  String?  @map("refund_id")
  kind      String
  amountInr Int      @map("amount_inr")
  eventKey  String   @unique @map("event_key")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payment GymPayment?    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  refund  PaymentRefund? @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt])
  @@index([paymentId])
  @@map("payment_ledger_entries")
}

model GymOtherExpense {
  id              String   @id @default(uuid())
  gymId           String   @map("gym_id")
  category        String
  title           String
  notes           String?
  amountInr       Int      @map("amount_inr")
  paidAt          DateTime @map("paid_at")
  proofMimeType   String?  @map("proof_mime_type")
  proofData       String?  @map("proof_data") @db.Text
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdBy User   @relation("OtherExpenseRecorder", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([gymId, paidAt])
  @@map("gym_other_expenses")
}

model GymSupplementSale {
  id              String    @id @default(uuid())
  gymId           String    @map("gym_id")
  memberUserId    String    @map("member_user_id")
  billNumber      String    @map("bill_number")
  lineItems       Json      @map("line_items")
  amountInr       Int       @map("amount_inr")
  paymentMethod   String    @map("payment_method")
  notes           String?
  proofMimeType   String?   @map("proof_mime_type")
  proofData       String?   @map("proof_data") @db.Text
  whatsappPhone   String?   @map("whatsapp_phone")
  whatsappStatus  String    @map("whatsapp_status")
  whatsappMessage String?   @map("whatsapp_message")
  whatsappSentAt  DateTime? @map("whatsapp_sent_at")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    User   @relation("SupplementSaleMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  createdBy User   @relation("SupplementSaleRecorder", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt])
  @@index([memberUserId])
  @@map("gym_supplement_sales")
}

model MemberCheckIn {
  id           String    @id @default(uuid())
  gymId        String    @map("gym_id")
  memberUserId String    @map("member_user_id")
  branchId     String?   @map("branch_id")
  branchName   String    @default("Main branch") @map("branch_name")
  checkInToken String?   @map("check_in_token")
  checkInAt    DateTime  @default(now()) @map("check_in_at")
  checkOutAt   DateTime? @map("check_out_at")

  tenant Tenant  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member User    @relation(fields: [memberUserId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([gymId, checkOutAt])
  @@index([gymId, branchId])
  @@index([memberUserId, checkInAt])
  @@map("member_check_ins")
}

model UserBranchAccess {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branch_access")
}

model WorkoutSetLog {
  id           String   @id @default(uuid())
  gymId        String   @map("gym_id")
  memberUserId String   @map("member_user_id")
  logDate      String   @map("log_date")
  dayId        String   @map("day_id")
