  @@map("food_catalog")
}

model FoodNutrition {
  foodCatalogId String    @id @map("food_catalog_id")
  per100g       Json      @map("per_100g")
  dataSource    String    @map("data_source")
  externalId    String?   @map("external_id")
  license       String?
  retrievedAt   DateTime? @map("retrieved_at")

  food FoodCatalog @relation(fields: [foodCatalogId], references: [id], onDelete: Cascade)

  @@map("food_nutrition")
}

model FoodRecipe {
  foodCatalogId String   @id @map("food_catalog_id")
  ingredients   Json
  yieldGrams    Decimal  @map("yield_grams") @db.Decimal(10, 2)
  cookingMethod String?  @map("cooking_method")

  food FoodCatalog @relation(fields: [foodCatalogId], references: [id], onDelete: Cascade)

  @@map("food_recipes")
}

model FoodBarcode {
  id            String    @id @default(uuid())
  barcode       String
  foodCatalogId String?   @map("food_catalog_id")
  provider      String
  providerId    String?   @map("provider_id")
  lastLookupAt  DateTime? @map("last_lookup_at")

  food FoodCatalog? @relation(fields: [foodCatalogId], references: [id], onDelete: SetNull)

  @@unique([barcode, provider])
  @@index([barcode])
  @@map("food_barcodes")
}

model ExternalFoodCache {
  id        String   @id @default(uuid())
  cacheKey  String   @unique @map("cache_key")
  provider  String
  payload   Json
  license   String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("external_food_cache")
}

model RegistrationInvite {
  id        String    @id @default(uuid())
  kind      String
  tokenHash String    @unique @map("token_hash")
  gymId     String?   @map("gym_id")
  email     String?
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([kind, usedAt])
  @@map("registration_invites")
}
