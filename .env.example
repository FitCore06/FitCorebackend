PORT=3001
NODE_ENV=development

# --- Local Docker Postgres ---
# DATABASE_URL="postgresql://fitcore:fitcore@localhost:5432/fitcore?schema=public"

# --- Supabase (project ref syemwfpinkqeejijrllq, region ap-southeast-2) ---
# Render runtime: Session pooler (user MUST be postgres.PROJECT_REF)
# Pooler host MUST match Dashboard → Connect (this project: aws-1, not aws-0).
# Render runtime (prefer transaction pooler + small Prisma pool — avoids EMAXCONNSESSION pool_size:15):
# DATABASE_URL="postgresql://postgres.syemwfpinkqeejijrllq:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&schema=public&sslmode=require"
# Migrations only (session pooler 5432) — do not share high connection counts with live API:
# MIGRATE_DATABASE_URL="postgresql://postgres.syemwfpinkqeejijrllq:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?schema=public&sslmode=require"
DATABASE_URL="postgresql://postgres.syemwfpinkqeejijrllq:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?schema=public&sslmode=require&connection_limit=5"

# Optional local-only (IPv6-capable networks). Render migrate uses pooler DATABASE_URL — see npm run render:migrate
# DIRECT_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.syemwfpinkqeejijrllq.supabase.co:5432/postgres?schema=public&sslmode=require"

# Comma-separated origins allowed for the admin web (Next.js default port)
CORS_ORIGINS="http://localhost:3000"

# Set true when Postgres is not running (local UI testing only)
DEV_AUTH_STUB=true

# Early prod: allow first gym owners to sign up without an invite code (default: invite required)
# ALLOW_OWNER_REGISTRATION_WITHOUT_INVITE=true

JWT_ACCESS_SECRET="change-me-use-long-random-string-in-production"

# Cron / automation (header X-FitCore-Automation-Secret on /api/v1/automation/*)
# FITCORE_AUTOMATION_SECRET="long-random-string"
# FITCORE_GYM_SLUG="demo-gym"
# FITCORE_EXPIRY_NOTIFY_DAYS="7,3,1,0"
# Auto daily ~9am IST inside the API (no Render cron required when true)
# FITCORE_MEMBERSHIP_EXPIRY_CRON_ENABLED=true
# Reminders: in-app notification + Expo phone push (optional FITCORE_MEMBERSHIP_EXPIRY_CHANNELS=in_app)

# Optional: Expo push (device tray) — https://expo.dev/accounts/[account]/settings/access-tokens
# EXPO_ACCESS_TOKEN=

# --- Week 3 prod checklist (expiry reminders) ---
# 1) prisma migrate deploy (session pooler URL for Supabase, not 6543)
# 2) FITCORE_AUTOMATION_SECRET + header X-FitCore-Automation-Secret on /automation/*
# 3) FITCORE_MEMBERSHIP_EXPIRY_CRON_ENABLED=true
# 4) FITCORE_GYM_SLUG=demo-gym  FITCORE_EXPIRY_NOTIFY_DAYS=7,3,1,0
# 5) EXPO_ACCESS_TOKEN — member app registers token via POST /notifications/devices
# Manual test: POST /api/v1/automation/membership-expiry/run?gymSlug=demo-gym

# Local Playwright / pentest: raise only on non-production runtimes (defaults: login 10/min, auth 20/min)
# AUTH_LOGIN_THROTTLE_LIMIT=200
# AUTH_PUBLIC_THROTTLE_LIMIT=60

# Optional: pin signup invite tokens when running npm run db:seed (local only)
# SEED_OWNER_INVITE_TOKEN=
# SEED_MEMBER_INVITE_TOKEN=

# Admin web URL for password reset links (e.g. https://fit-core-mocha.vercel.app)
APP_PUBLIC_URL="http://localhost:3000"
# Return reset link in API JSON when email is not wired yet (demo / staging)
PASSWORD_RESET_EXPOSE_LINK=true

# Password reset email (https://resend.com — free tier works for testing)
# RESEND_API_KEY=re_xxxxxxxx
# PASSWORD_RESET_FROM_EMAIL="FitCore <noreply@your-verified-domain.com>"

# Nutrition scanner (optional — core app works when vision is off)
NUTRITION_VISION_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_READINESS_TIMEOUT_MS=3000
OLLAMA_READINESS_TTL_MS=45000

# Open Food Facts — global packaged foods (free, on by default)
# OPEN_FOOD_FACTS_ENABLED=true
OPEN_FOOD_FACTS_SEARCH_URL=https://search.openfoodfacts.org
OPEN_FOOD_FACTS_TIMEOUT_MS=10000

# USDA FoodData Central (optional — extra US government foods)
# USDA_API_KEY=
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_TIMEOUT_MS=8000
NUTRITION_CACHE_TTL_HOURS=168