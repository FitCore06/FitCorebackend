{
  "name": "fitcore-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "predev": "sh -c 'lsof -ti :3001 2>/dev/null | xargs kill -9 2>/dev/null || true'",
    "dev": "nest start --watch",
    "prestart:dev": "prisma generate && sh -c 'lsof -ti :3001 2>/dev/null | xargs kill -9 2>/dev/null || true'",
    "build": "sh scripts/compile.sh",
    "render:build": "bash scripts/render-build.sh",
    "render:migrate": "sh scripts/render-migrate.sh",
    "render:env-check": "sh scripts/validate-render-env.sh",
    "render:local-test": "sh scripts/render-local-test.sh",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:supabase:setup": "prisma generate && prisma migrate deploy",
    "db:directory-seed": "tsx scripts/seed-gym-directory-only.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:qa": "tsx prisma/qa-populate.ts",
    "security:audit": "tsx scripts/security-audit.ts",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^6.19.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.19",
    "@rolldown/binding-darwin-x64": "1.2.19",
    "@rolldown/binding-linux-arm64-gnu": "1.2.19",
    "@rolldown/binding-linux-x64-gnu": "1.2.19"
  }
}
